@startuml AB_Granite_ERD
!define table(x) entity x << (T,#FFAAAA) >>
skinparam linetype ortho
skinparam roundcorner 5

title AB Granite Quarry ERP - Entity Relationship Diagram (Complete - v1.1)

' ============================================================================
' LEGEND
' ============================================================================
legend top right
  **Color Coding:**
  #E6F3FF = Organization & Hierarchy
  #FFE6E6 = Master Data
  #E6FFE6 = Operations
  #FFF9E6 = Sales & Despatch
  #F0E6FF = Finance & Accounting
  #FFEEEE = HR & Payroll
  #E6F9F9 = Compliance & Safety
  **Key:**  PK = Primary Key, FK = Foreign Key, UK = Unique Key
end legend

' ============================================================================
' ORGANIZATION HIERARCHY
' ============================================================================
package "Organization Hierarchy" #E6F3FF {
  
  entity organizations {
    * id : SERIAL <<PK>>
    --
    * org_code : VARCHAR(20) <<UK>>
    * org_name : VARCHAR(200)
    legal_entity_type : VARCHAR(50)
    pan : VARCHAR(10)
    gstin : VARCHAR(15)
    incorporation_date : DATE
    registered_address : TEXT
    contact_email : VARCHAR(100)
    contact_phone : VARCHAR(20)
    active : BOOLEAN
    created_at : TIMESTAMP
    created_by : INT <<FK users>>
  }
  
  entity quarries {
    * id : SERIAL <<PK>>
    --
    * org_id : INT <<FK organizations>>
    * quarry_code : VARCHAR(20) <<UK>>
    * quarry_name : VARCHAR(200)
    quarry_type : VARCHAR(50)
    mineral_type : VARCHAR(100)
    address : TEXT
    village : VARCHAR(100)
    taluk : VARCHAR(100)
    district : VARCHAR(100)
    state : VARCHAR(100)
    pincode : VARCHAR(10)
    latitude : DECIMAL(10,8)
    longitude : DECIMAL(11,8)
    lease_id : INT <<FK leases>>
    operational_status : VARCHAR(50)
    commencement_date : DATE
    gstin : VARCHAR(15)
    place_of_supply : VARCHAR(100)
    dgms_registration_no : VARCHAR(50)
    ibm_code : VARCHAR(50)
    active : BOOLEAN
    created_at : TIMESTAMP
  }
  
  entity cost_centers {
    * id : SERIAL <<PK>>
    --
    * org_id : INT <<FK organizations>>
    * quarry_id : INT <<FK quarries>>
    * cost_center_code : VARCHAR(20) <<UK>>
    * cost_center_name : VARCHAR(200)
    parent_cost_center_id : INT <<FK cost_centers>>
    cost_center_type : VARCHAR(50)
    head_employee_id : INT <<FK employees>>
    active : BOOLEAN
  }
  
  entity locations {
    * id : SERIAL <<PK>>
    --
    * org_id : INT <<FK organizations>>
    * quarry_id : INT <<FK quarries>>
    cost_center_id : INT <<FK cost_centers>>
    * location_code : VARCHAR(20) <<UK>>
    * location_name : VARCHAR(200)
    location_type : VARCHAR(50)
    parent_location_id : INT <<FK locations>>
    geo_coordinates : TEXT
    area_sqm : DECIMAL(12,2)
    bench_level : VARCHAR(20)
    bench_height_m : DECIMAL(5,2)
    bench_width_m : DECIMAL(5,2)
    slope_angle_deg : DECIMAL(5,2)
    active : BOOLEAN
  }
}

